<%- include('partials/head') %>
<main id="main">
  <%- include('partials/crumbs') %>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><%= town.region %> · <%= town.name %>, MA</span>
      <h1 class="h1"><%= c.h1 %></h1>
      <p class="lede">House teardowns, light commercial demo, garage and shed removal, pool and concrete removal and site prep for <%= town.name %> homeowners, builders and property owners.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/contact?town=<%= town.slug %>">Get a free estimate</a>
        <a class="btn btn-ghost" href="<%= biz.phoneHref %>">Call <%= biz.phone %></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="narrow prose reveal">
      <p><strong>Demolition in <%= town.name %>, Massachusetts.</strong> <%= town.note %></p>
      <p><%= town.demo %></p>
      <% if (town.villages.length) { %><p>We work throughout <%= town.name %>, including <%= list(town.villages) %>. Whether it’s a full teardown, a garage that’s past saving, an old pool, a cracked slab or a lot that needs clearing, one call to Travers Demolition covers the demolition, the haul-off and the site prep.</p><% } %>
    </div>
  </section>

  <section class="section alt" style="padding-top:80px">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Services</span><h2 class="h2">What we take down in <%= town.name %>.</h2></div>
      <div class="mt-l reveal"><%- include('partials/service-links', { town }) %></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="specs reveal">
        <div class="spec"><b><%= biz.years %></b><span>Years, same family</span></div>
        <div class="spec"><b><%= services.length %></b><span>Demolition services</span></div>
        <div class="spec"><b>100%</b><span>Jobs with debris hauled</span></div>
        <div class="spec"><b>1</b><span>Crew, teardown to grade</span></div>
      </div>
    </div>
  </section>

  <%- include('partials/process') %>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Nearby towns</span><h2 class="h2">Also serving towns near <%= town.name %>.</h2></div>
      <div class="chips mt-l reveal">
        <% nearby.forEach(t => { %><a class="chip" href="<%= townUrl(t) %>">Demolition in <%= t.name %></a><% }) %>
        <a class="chip home" href="/service-areas">All service areas ›</a>
      </div>
    </div>
  </section>

  <%- include('partials/cta', { ctaTitle: 'Your ' + town.name + ' project starts here.', ctaQuery: '?town=' + town.slug }) %>
</main>
<%- include('partials/footer') %>
