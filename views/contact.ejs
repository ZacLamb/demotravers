<%- include('partials/head') %>
<main id="main">
  <%- include('partials/crumbs') %>
  <section class="page-hero" style="padding-bottom:10px">
    <div class="wrap">
      <span class="eyebrow">Free demolition estimates</span>
      <h1 class="h1">Tell us what needs to come down.</h1>
      <p class="lede">A few details about the property and the project, and we’ll call you back to set up a site walk.</p>
    </div>
  </section>
  <section class="section" style="padding-top:60px">
    <div class="wrap contact-grid">
      <div class="contact-info">
        <div class="card" style="background:var(--bg-alt)">
          <dl style="margin:0">
            <dt>Phone</dt><dd><a class="phone-big" href="<%= biz.phoneHref %>"><%= biz.phone %></a></dd>
            <dt>Email</dt><dd><a href="mailto:<%= biz.email %>"><%= biz.email %></a></dd>
            <dt>Address</dt><dd><%= biz.street %><br><%= biz.city %>, <%= biz.state %> <%= biz.zip %></dd>
            <dt>Service area</dt><dd style="margin-bottom:0">The South Shore & Cape Cod Canal — <%= biz.coverage %></dd>
          </dl>
        </div>
        <div class="card" style="background:var(--dark);color:var(--on-dark)">
          <h3>Have photos?</h3>
          <p style="color:var(--on-dark-2)">Photos of the structure and the access to it help us estimate faster. Text them to us after you submit.</p>
          <a class="btn btn-primary mt" href="sms:+15088889432">Text <%= biz.phone %></a>
        </div>
        <div class="card bordered">
          <h3>Contractor or developer?</h3>
          <p>Use the bid request form to send drawings, scope and dates.</p>
          <a class="more chev" href="/services/commercial-demolition#bid" style="display:inline-block;margin-top:12px">Request a bid</a>
        </div>
        <div class="map mt">
          <iframe title="Map to Travers Group, 152 Cranberry Highway, Bourne MA" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=<%= encodeURIComponent(biz.street + ', ' + biz.city + ', ' + biz.state + ' ' + biz.zip) %>&z=11&output=embed"></iframe>
        </div>
      </div>
      <div class="form-shell">
        <form class="leadform" id="estimate" method="post" action="/api/lead" novalidate>
          <h2 class="leadform__title">Request a demolition estimate</h2>
          <p class="leadform__sub">We’ll call you back to schedule a time to walk the property.</p>
          <input type="hidden" name="page" value="/contact">
          <div class="hp" aria-hidden="true"><label>Website <input name="company_website" tabindex="-1" autocomplete="off"></label></div>
          <div class="fld-row">
            <label class="fld"><span>Name</span><input name="name" autocomplete="name" required></label>
            <label class="fld"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" required></label>
          </div>
          <label class="fld"><span>Email <em>(optional)</em></span><input name="email" type="email" autocomplete="email"></label>
          <div class="fld-row">
            <label class="fld"><span>I am a…</span>
              <select name="customer_type">
                <% ['Homeowner', 'Contractor / builder', 'Property manager', 'Commercial owner', 'Developer', 'Real estate / estate sale'].forEach(o => { %><option <%= preType === o ? 'selected' : '' %>><%= o %></option><% }) %>
              </select></label>
            <label class="fld"><span>Project type</span>
              <select name="service">
                <option value="">Not sure yet</option>
                <% services.forEach(s => { %><option value="<%= s.slug %>" <%= preService === s.slug ? 'selected' : '' %>><%= s.name %></option><% }) %>
              </select></label>
          </div>
          <label class="fld"><span>Project address</span><input name="address" autocomplete="street-address"></label>
          <div class="fld-row">
            <label class="fld"><span>Town</span>
              <select name="town">
                <option value="">Select your town</option>
                <% towns.forEach(t => { %><option value="<%= t.slug %>" <%= preTown === t.slug ? 'selected' : '' %>><%= t.name %></option><% }) %>
                <option value="Other">Other</option>
              </select></label>
            <label class="fld"><span>Timeline</span>
              <select name="timeline"><option>As soon as possible</option><option>Within 1–3 months</option><option>3+ months out</option><option>Just budgeting</option></select></label>
          </div>
          <label class="fld"><span>What needs to come down?</span><textarea name="message" rows="4" placeholder="Structure type and rough size, what stays, access for equipment, and what’s going in next."></textarea></label>
          <label class="fld"><span>Best way to reach you</span>
            <select name="contact_pref"><option>Call</option><option>Text</option><option>Email</option></select></label>
          <button class="btn btn-primary leadform__btn" type="submit">Get my free estimate</button>
          <p class="leadform__msg" role="status" aria-live="polite"></p>
          <p class="leadform__fine">By submitting you agree to be contacted by Travers Demolition (Travers Group) about your request by phone, text or email. Msg &amp; data rates may apply. Reply STOP to opt out.</p>
        </form>
        <div class="leadform__done" hidden>
          <h2 class="leadform__title">Thanks — we got it.</h2>
          <p>We’ll be in touch shortly to set up a site walk. Have photos? Text them to <a href="sms:+15088889432"><%= biz.phone %></a>.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Services</span><h2 class="h2">What can we take down?</h2></div>
      <div class="mt-l reveal"><%- include('partials/service-links') %></div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
