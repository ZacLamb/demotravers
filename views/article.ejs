<%- include('partials/head') %>
<main id="main">
  <%- include('partials/crumbs') %>
  <article>
    <header class="page-hero article-hero">
      <div class="wrap">
        <span class="eyebrow"><%= article.category %> · <%= article.readMins %> min read</span>
        <h1 class="h1"><%= article.title %></h1>
        <p class="lede"><%= article.summary %></p>
        <p class="article-meta">Travers Demolition · <time datetime="<%= article.date %>"><%= new Date(article.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></time></p>
      </div>
      <div class="page-hero-media"><img src="<%= img(article.img, 1800) %>" srcset="<%= srcset(article.img) %>" sizes="100vw" alt="<%= article.title %>" fetchpriority="high"></div>
    </header>

    <section class="section">
      <div class="narrow prose article-body">
        <% article.sections.forEach(s => { %>
          <% if (s.h) { %><h2><%= s.h %></h2><% } %>
          <% (s.p || []).forEach(p => { %><p><%- p %></p><% }) %>
          <% if (s.list) { %><ul><% s.list.forEach(li => { %><li><%- li %></li><% }) %></ul><% } %>
        <% }) %>
        <p class="article-note">This guide is general information for South Shore property owners, not legal advice. Permit and notice requirements vary by town and project — confirm with your building department.</p>
      </div>
    </section>
  </article>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Related services</span><h2 class="h2">Get it done.</h2></div>
      <div class="mt-l reveal"><%- include('partials/service-links', { only: article.services }) %></div>
      <% const more = articles.filter(a => a.slug !== article.slug); if (more.length) { %>
      <div class="links-row mt-l"><% more.forEach(a => { %><a class="chev" href="<%= artUrl(a) %>">Next guide: <%= a.title %></a><% }) %></div>
      <% } %>
    </div>
  </section>

  <script type="application/ld+json"><%- JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Article', headline: article.title, description: article.meta,
    datePublished: article.date, dateModified: article.date, image: img(article.img, 1200),
    mainEntityOfPage: SITE_URL + artUrl(article),
    author: { '@type': 'Organization', name: biz.name, url: SITE_URL },
    publisher: { '@id': SITE_URL + '/#business' },
  }) %></script>
  <%- include('partials/cta', { ctaQuery: '?service=' + article.services[0] }) %>
</main>
<%- include('partials/footer') %>
